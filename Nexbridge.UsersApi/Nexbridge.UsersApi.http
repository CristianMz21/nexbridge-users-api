@Nexbridge_UsersApi_HostAddress = http://localhost:5241

# Note:
# The "Request '...' has not been sent" diagnostics are normal until you run
# the previous named request (CreateValidUser / CreateUser1). Run those first
# or use "REST Client: Send All Requests" on this file.

### API root
@contentType = application/json
@apiKey = secret-key
@sampleUserId = d20a84dc-8fd2-4f8d-9b8c-9a53f4f4ec8c

### List all users
GET {{Nexbridge_UsersApi_HostAddress}}/users
Accept: {{contentType}}

### Create a valid user
# @name CreateValidUser
POST {{Nexbridge_UsersApi_HostAddress}}/users
Content-Type: {{contentType}}

{
  "firstName": "Ana",
  "lastName": "Taylor",
  "email": "ana@example.com",
  "age": 34
}

### Get user by id
GET {{Nexbridge_UsersApi_HostAddress}}/users/{{CreateValidUser.response.body.id}}
Accept: {{contentType}}

### Update a user
PUT {{Nexbridge_UsersApi_HostAddress}}/users/{{CreateValidUser.response.body.id}}
Content-Type: {{contentType}}

{
  "firstName": "Ana",
  "lastName": "Johnson",
  "email": "ana.johnson@update.com",
  "age": 35
}

### Delete user
DELETE {{Nexbridge_UsersApi_HostAddress}}/users/{{CreateValidUser.response.body.id}}

### Request with invalid data (validation errors)
POST {{Nexbridge_UsersApi_HostAddress}}/users
Content-Type: {{contentType}}

{
  "firstName": "",
  "lastName": "",
  "email": "not-an-email",
  "age": 0
}

### Check not-found user
GET {{Nexbridge_UsersApi_HostAddress}}/users/{{sampleUserId}}
Accept: {{contentType}}

### Create duplicate email
POST {{Nexbridge_UsersApi_HostAddress}}/users
Content-Type: {{contentType}}

{
  "firstName": "Frank",
  "lastName": "Miller",
  "email": "frank@example.com",
  "age": 40
}

### Try duplicate email
POST {{Nexbridge_UsersApi_HostAddress}}/users
Content-Type: {{contentType}}

{
  "firstName": "Frank",
  "lastName": "Miller",
  "email": "frank@example.com",
  "age": 40
}

### Create two users then update with conflicting email
# @name CreateUser1
POST {{Nexbridge_UsersApi_HostAddress}}/users
Content-Type: {{contentType}}

{
  "firstName": "Gina",
  "lastName": "Doe",
  "email": "gina@example.com",
  "age": 20
}

# @name CreateUser2
POST {{Nexbridge_UsersApi_HostAddress}}/users
Content-Type: {{contentType}}

{
  "firstName": "Henry",
  "lastName": "Page",
  "email": "henry@example.com",
  "age": 22
}

### Force email conflict on update
# This request is standalone. If you want a dynamic conflict flow, first run the two
# "CreateUser" requests above and replace `sampleUserId` with the id returned by
# CreateUser1.
PUT {{Nexbridge_UsersApi_HostAddress}}/users/{{sampleUserId}}
Content-Type: {{contentType}}

{
  "firstName": "Gina",
  "lastName": "Doe",
  "email": "henry@example.com",
  "age": 21
}

### API key missing (when API key is configured in app settings)
GET {{Nexbridge_UsersApi_HostAddress}}/users
Accept: {{contentType}}

### API key provided (when API key is configured in app settings)
GET {{Nexbridge_UsersApi_HostAddress}}/users
X-Api-Key: {{apiKey}}
Accept: {{contentType}}
